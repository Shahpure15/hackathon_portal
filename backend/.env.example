# Database Connection URL (PgBouncer-pooled Neon connection string for production)
DATABASE_URL=postgresql://user:password@neon-pooler-domain/dbname?sslmode=require

# Environment ("development" or "production")
ENVIRONMENT=development

# Security Secrets (Generate secure random 64-hex strings in production)
JWT_SECRET_KEY=9a6b98e72e1f40d39e2621cb039b4b0e8c89c8a9d0f04fa18dbd846fa5cf613c
JWT_REFRESH_SECRET_KEY=2e84d4b1a43a41cb982e0a295c52c2f0f81d11e8a8d052b0f4a8b7ea8b9c02ff

# Token Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token duration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Setup - Comma separated domains allowed to query the API (e.g. Vercel frontend app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://mitindia.vercel.app,https://mitinida-hackathon-portal.vercel.app,https://hackathon.mitindia.com,https://www.hackathon.mitindia.com
# Optional: regex for Vercel preview deployments of YOUR team only. Leave empty if unused.
# CORS_ALLOWED_ORIGIN_REGEX=https://<project>(-[a-z0-9-]+)?-<your-vercel-team-slug>[.]vercel[.]app

# Monitoring & Observability
SENTRY_DSN=

# Database Seeding Custom Overrides (Defaults to random 16-char strings in production if unset)
ADMIN_SEED_PASSWORD=
VOLUNTEER_SEED_PASSWORD=
